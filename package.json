{
  "name": "neat-markdown-editor",
  "publisher": "nufunc",
  "displayName": "Neat MD Editor",
  "icon": "icon.png",
  "description": "Neat & Aesthetic WYSIWYG Markdown Editor with Mermaid",
  "version": "0.1.0",
  "author": "nufunc <nufunc@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nufunc/neat-markdown-editor.git"
  },
  "bugs": {
    "url": "https://github.com/nufunc/neat-markdown-editor/issues"
  },
  "homepage": "https://github.com/nufunc/neat-markdown-editor#readme",
  "keywords": [
    "markdown",
    "editor",
    "mermaid",
    "wysiwyg"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "neatMdEditor.mdEditor",
        "displayName": "Neat MD Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.llm.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "neatMdEditor.openWithTextEditor",
        "title": "Open with Text Editor",
        "category": "Neat MD Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "neatMdEditor.openWithNeatEditor",
        "title": "Open with Neat MD Editor",
        "category": "Neat MD Editor",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "neatMdEditor.openWithTextEditor",
          "when": "activeCustomEditorId == neatMdEditor.mdEditor",
          "group": "navigation"
        },
        {
          "command": "neatMdEditor.openWithNeatEditor",
          "when": "editorLangId == markdown && activeCustomEditorId != neatMdEditor.mdEditor",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Neat MD Editor",
      "properties": {
        "neatMdEditor.fontSize": {
          "type": "number",
          "default": 16,
          "description": "Font size for the Neat MD Editor"
        },
        "neatMdEditor.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark",
            "nord",
            "one-half-dark",
            "solarized-dark",
            "vintage",
            "gruvbox-dark",
            "tokyo-night-day"
          ],
          "enumDescriptions": [
            "Match VS Code theme",
            "Light theme",
            "Dark theme",
            "Nord theme (Cool frosty dark)",
            "One Half Dark",
            "Solarized Dark",
            "Vintage",
            "Gruvbox Dark (Warm retro dark)",
            "Tokyo Night Day (Cool pastel light)"
          ],
          "default": "auto",
          "description": "Select the theme for the Neat MD Editor. 'auto' follows the VS Code theme."
        },
        "neatMdEditor.autoFix": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run Auto-Fix formatting (Prettier) on save or edit."
        },
        "neatMdEditor.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh editor when the document changes externally."
        },
        "neatMdEditor.showToc": {
          "type": "boolean",
          "default": false,
          "description": "Show Table of Contents by default."
        },
        "neatMdEditor.showProperties": {
          "type": "boolean",
          "default": false,
          "description": "Show Document Properties (Frontmatter) by default."
        },
        "neatMdEditor.defaultCodeLanguage": {
          "type": "string",
          "default": "text",
          "description": "Default language for newly created code blocks."
        }
      }
    },
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "{git,gitlens}:/**/*.md": "default"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run compile",
    "compile": "node -e \"fs.rmSync('out',{recursive:true,force:true})\" && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "cd webview && npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
