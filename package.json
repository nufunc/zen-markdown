{
  "name": "zen-markdown",
  "publisher": "nufunc",
  "displayName": "Zen Markdown",
  "icon": "icon.png",
  "description": "Minimalist & Aesthetic WYSIWYG Markdown Editor with Mermaid",
  "version": "0.5.1",
  "author": "nufunc <nufunc@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nufunc/zen-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/nufunc/zen-markdown/issues"
  },
  "homepage": "https://github.com/nufunc/zen-markdown#readme",
  "keywords": [
    "markdown",
    "editor",
    "mermaid",
    "wysiwyg"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "zenMarkdown.mdEditor",
        "displayName": "Zen Markdown",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.llm.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "zenMarkdown.openWithTextEditor",
        "title": "Open with Text Editor",
        "category": "Zen Markdown",
        "icon": "$(go-to-file)"
      },
      {
        "command": "zenMarkdown.openWithZenEditor",
        "title": "Open with Zen Markdown",
        "category": "Zen Markdown",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "zenMarkdown.openWithTextEditor",
          "when": "activeCustomEditorId == zenMarkdown.mdEditor",
          "group": "navigation"
        },
        {
          "command": "zenMarkdown.openWithZenEditor",
          "when": "editorLangId == markdown && activeCustomEditorId != zenMarkdown.mdEditor",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Zen Markdown",
      "properties": {
        "zenMarkdown.fontSize": {
          "type": "number",
          "default": 16,
          "description": "Font size for Zen Markdown"
        },
        "zenMarkdown.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark",
            "nord",
            "one-half-dark",
            "solarized-dark",
            "vintage",
            "gruvbox-dark",
            "tokyo-night-day",
            "orca"
          ],
          "enumDescriptions": [
            "Match VS Code theme",
            "Light theme",
            "Dark theme",
            "Nord theme (Cool frosty dark)",
            "One Half Dark",
            "Solarized Dark",
            "Vintage",
            "Gruvbox Dark (Warm retro dark)",
            "Tokyo Night Day (Cool pastel light)",
            "Orca (Deep Black & Emerald)"
          ],
          "default": "auto",
          "description": "Select the theme for Zen Markdown. 'auto' follows the VS Code theme."
        },
        "zenMarkdown.autoFix": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run Auto-Fix formatting (Prettier) on save or edit."
        },
        "zenMarkdown.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh editor when the document changes externally."
        },
        "zenMarkdown.showToc": {
          "type": "boolean",
          "default": false,
          "description": "Show Table of Contents by default."
        },
        "zenMarkdown.showProperties": {
          "type": "boolean",
          "default": false,
          "description": "Show Document Properties (Frontmatter) by default."
        },
        "zenMarkdown.defaultCodeLanguage": {
          "type": "string",
          "default": "text",
          "description": "Default language for newly created code blocks."
        },
        "zenMarkdown.focusMode": {
          "type": "boolean",
          "default": false,
          "description": "Dim inactive blocks to help you focus on the current block."
        },
        "zenMarkdown.spellCheck": {
          "type": "boolean",
          "default": false,
          "description": "Enable native spell checking in the editor."
        },
        "zenMarkdown.contentWidth": {
          "type": "string",
          "enum": ["narrow", "standard", "full"],
          "default": "standard",
          "description": "Maximum width of the editor content. Narrow (700px), Standard (900px), Full (100% - default max of VS Code)."
        }
      }
    },
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "{git,gitlens}:/**/*.md": "default"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run compile",
    "compile": "node -e \"fs.rmSync('out',{recursive:true,force:true})\" && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "cd webview && npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
