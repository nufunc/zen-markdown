{
  "name": "zen-markdown",
  "publisher": "nufunc",
  "displayName": "Zen Markdown",
  "icon": "icon.png",
  "description": "Minimalist & Aesthetic WYSIWYG Markdown Editor with Mermaid",
  "version": "0.7.1",
  "author": "nufunc <nufunc@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nufunc/zen-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/nufunc/zen-markdown/issues"
  },
  "homepage": "https://github.com/nufunc/zen-markdown#readme",
  "keywords": [
    "markdown",
    "editor",
    "mermaid",
    "wysiwyg"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "zenMarkdown.mdEditor",
        "displayName": "Zen Markdown",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.llm.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "zenMarkdown.openWithTextEditor",
        "title": "Open with Text Editor",
        "category": "Zen Markdown",
        "icon": "$(go-to-file)"
      },
      {
        "command": "zenMarkdown.openWithZenEditor",
        "title": "Open with Zen Markdown",
        "category": "Zen Markdown",
        "icon": "$(open-preview)"
      },
      {
        "command": "zenMarkdown.showDiagnostics",
        "title": "Show Diagnostics Report",
        "category": "Zen Markdown",
        "icon": "$(pulse)"
      },
      {
        "command": "zenMarkdown.openDiagnosticsFolder",
        "title": "Open Diagnostics Log Folder",
        "category": "Zen Markdown",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "zenMarkdown.openWithTextEditor",
          "when": "activeCustomEditorId == zenMarkdown.mdEditor",
          "group": "navigation"
        },
        {
          "command": "zenMarkdown.openWithZenEditor",
          "when": "editorLangId == markdown && activeCustomEditorId != zenMarkdown.mdEditor",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Zen Markdown",
      "properties": {
        "zenMarkdown.fontSize": {
          "type": "number",
          "default": 16,
          "description": "Font size for Zen Markdown"
        },
        "zenMarkdown.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark",
            "nord",
            "one-half-dark",
            "solarized-dark",
            "vintage",
            "gruvbox-dark",
            "tokyo-night-day",
            "orca"
          ],
          "enumDescriptions": [
            "Match VS Code theme",
            "Light theme",
            "Dark theme",
            "Nord theme (Cool frosty dark)",
            "One Half Dark",
            "Solarized Dark",
            "Vintage",
            "Gruvbox Dark (Warm retro dark)",
            "Tokyo Night Day (Cool pastel light)",
            "Orca (Deep Black & Emerald)"
          ],
          "default": "auto",
          "description": "Select the theme for Zen Markdown. 'auto' follows the VS Code theme."
        },
        "zenMarkdown.autoFix": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run Auto-Fix formatting (Prettier) on save or edit."
        },
        "zenMarkdown.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh editor when the document changes externally."
        },
        "zenMarkdown.showToc": {
          "type": "boolean",
          "default": false,
          "description": "Show Table of Contents by default."
        },
        "zenMarkdown.showProperties": {
          "type": "boolean",
          "default": true,
          "description": "Show Document Properties (Frontmatter) by default."
        },
        "zenMarkdown.defaultCodeLanguage": {
          "type": "string",
          "default": "text",
          "description": "Default language for newly created code blocks."
        },
        "zenMarkdown.focusMode": {
          "type": "boolean",
          "default": false,
          "description": "Dim inactive blocks to help you focus on the current block."
        },
        "zenMarkdown.spellCheck": {
          "type": "boolean",
          "default": false,
          "description": "Enable native spell checking in the editor."
        },
        "zenMarkdown.contentWidth": {
          "type": "string",
          "enum": [
            "narrow",
            "standard",
            "full"
          ],
          "default": "standard",
          "description": "Maximum width of the editor content. Narrow (700px), Standard (900px), Full (100% - default max of VS Code)."
        },
        "zenMarkdown.defaultMode": {
          "type": "string",
          "enum": [
            "wysiwyg",
            "raw"
          ],
          "enumDescriptions": [
            "WYSIWYG Rich Block Editor",
            "Raw Markdown Source Editor"
          ],
          "default": "wysiwyg",
          "description": "Default editing mode when opening a markdown document."
        },
        "zenMarkdown.showWordCount": {
          "type": "boolean",
          "default": true,
          "description": "Show word and character count badge in the header bar."
        },
        "zenMarkdown.showFormattingToolbar": {
          "type": "boolean",
          "default": true,
          "description": "Show the rich formatting toolbar in WYSIWYG mode."
        },
        "zenMarkdown.typewriterMode": {
          "type": "boolean",
          "default": false,
          "description": "Keep active typing line/block vertically centered in the viewport (Typewriter Scrolling)."
        },
        "zenMarkdown.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Record local diagnostic events (errors and round-trip self-checks) to help find editor problems. Document content is never recorded and nothing is sent over the network. Use \"Zen Markdown: Show Diagnostics Report\" to view."
        }
      }
    },
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "{git,gitlens}:/**/*.md": "default"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run compile",
    "compile": "node -e \"fs.rmSync('out',{recursive:true,force:true})\" && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "cd webview && npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
